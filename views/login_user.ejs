<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>ShramSetu | Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="style/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    .btn-primary {
      background: linear-gradient(to right, #3b82f6, #2563eb);
      color: white;
      padding: 0.75rem 1.75rem;
      border-radius: 0.5rem;
      font-weight: 600;
      font-size: 1rem;
      border: none;
      cursor: pointer;
      width: 100%;
      transition: all 0.2s ease;
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
    }
    input:focus {
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
      outline: none;
    }
  </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-100 to-white">

  <nav class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between py-4">
        <div class="hidden sm:flex items-center space-x-5">
          <a href="/" class="text-3xl font-bold text-blue-700 no-underline hover:no-underline">ShramSetu</a>
        </div>
        <div class="hidden sm:flex items-center space-x-5">
        <a href="#whyShramSetu" class="text-gray-700 hover:text-blue-600 hover:no-underline font-semibold">Why ShramSetu</a>
        <a href="/hire" class="text-gray-700 hover:text-blue-600 hover:no-underline font-semibold">Hire ShramSevik</a>
        <a href="/work" class="text-gray-700 hover:text-blue-600 hover:no-underline font-semibold">Find Work</a>
        <a href="#categories" class="text-gray-700 hover:text-blue-600 hover:no-underline font-semibold">Categories</a>
        <a href="/about" class="text-gray-700 hover:text-blue-600 hover:no-underline font-semibold">About Us</a>
        <a href="/login_user" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 font-semibold no-underline hover:no-underline">Join</a>
        </div>
        <div class="-mr-2 flex items-center sm:hidden">
          <button class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:bg-gray-100 focus:text-gray-500 transition">
            <svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Section -->
  <section class="flex justify-center items-center min-h-[calc(100vh-80px)] px-4 md:px-8 lg:px-24">
    <div class="flex flex-col lg:flex-row items-center justify-center gap-12 w-full max-w-6xl">

      <!-- Left Text Block -->
     <div class="w-full lg:w-2/5 px-4 lg:px-0 flex flex-col justify-center space-y-6">
     <div class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-100 to-blue-200 text-blue-800 text-sm font-semibold px-5 py-3 rounded-full shadow-md">
     <span class="animate-pulse">
       <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2C11.45 2 11 2.45 11 3V5C11 5.55 11.45 6 12 6C12.55 6 13 5.55 13 5V3C13 2.45 12.55 2 12 2ZM5.64 5.64C5.24 6.05 5.24 6.68 5.64 7.09L7.05 8.5C7.45 8.91 8.08 8.91 8.49 8.5C8.9 8.09 8.9 7.46 8.49 7.05L7.08 5.64C6.68 5.24 6.05 5.24 5.64 5.64ZM2 12C2 11.45 2.45 11 3 11H5C5.55 11 6 11.45 6 12C6 12.55 5.55 13 5 13H3C2.45 13 2 12.55 2 12ZM5.64 18.36C6.05 18.76 6.68 18.76 7.09 18.36L8.5 16.95C8.91 16.55 8.91 15.92 8.5 15.51C8.09 15.1 7.46 15.1 7.05 15.51L5.64 16.92C5.24 17.32 5.24 17.95 5.64 18.36ZM12 18C11.45 18 11 18.45 11 19V21C11 21.55 11.45 22 12 22C12.55 22 13 21.55 13 21V19C13 18.45 12.55 18 12 18ZM18.36 18.36C18.76 17.95 18.76 17.32 18.36 16.91L16.95 15.5C16.54 15.09 15.91 15.09 15.5 15.5C15.09 15.91 15.09 16.54 15.5 16.95L16.91 18.36C17.32 18.76 17.95 18.76 18.36 18.36ZM19 11H21C21.55 11 22 11.45 22 12C22 12.55 21.55 13 21 13H19C18.45 13 18 12.55 18 12C18 11.45 18.45 11 19 11ZM16.95 8.5C17.36 8.91 17.99 8.91 18.4 8.5C18.81 8.09 18.81 7.46 18.4 7.05L16.99 5.64C16.58 5.24 15.95 5.24 15.54 5.64C15.13 6.05 15.13 6.68 15.54 7.09L16.95 8.5ZM12 8C9.79 8 8 9.79 8 12C8 14.21 9.79 16 12 16C14.21 16 16 14.21 16 12C16 9.79 14.21 8 12 8Z"/>
       </svg>
     </span>   
     <span class="tracking-wide">Empowering India's Workforce</span>
     </div>

        <h1 class="text-4xl lg:text-5xl font-extrabold text-gray-800 leading-snug">
          Build Connections <br class="hidden lg:block" />
          That <span class="text-blue-600">Actually Work</span>
        </h1>
        <p class="text-gray-600 text-base lg:text-lg">
          ShramSetu helps skilled laborers and employers find each other faster and easier. Zero commission, maximum opportunity.
        </p>
        <div class="grid grid-cols-2 gap-4 mt-6 text-sm text-gray-800">
  <div class="flex items-center gap-3 bg-blue-50 px-4 py-3 rounded-lg">
    <div class="bg-blue-100 p-2 rounded-full">
      <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2"
        viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </div>
    <span class="font-medium">No middlemen</span>
  </div>

  <div class="flex items-center gap-3 bg-blue-50 px-4 py-3 rounded-lg">
    <div class="bg-blue-100 p-2 rounded-full">
      <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2"
        viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </div>
    <span class="font-medium">Fast job matching</span>
  </div>

  <div class="flex items-center gap-3 bg-blue-50 px-4 py-3 rounded-lg">
    <div class="bg-blue-100 p-2 rounded-full">
      <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2"
        viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </div>
    <span class="font-medium">Realtime alerts</span>
  </div>

  <div class="flex items-center gap-3 bg-blue-50 px-4 py-3 rounded-lg">
    <div class="bg-blue-100 p-2 rounded-full">
      <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2"
        viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </div>
    <span class="font-medium">Secure identity</span>
  </div>
</div>
      </div>

      <!-- Right Login Box -->
      <div class="w-full lg:w-1/2 bg-white shadow-lg rounded-xl p-8 md:p-10 max-w-md mx-auto lg:mx-0">
        <h2 class="text-2xl font-bold text-gray-800 mb-3 text-center">Welcome Back</h2>
        <p class="text-gray-500 mb-6 text-sm text-center">Login to continue exploring ShramSetu</p>

        <form method="post" action="/login_user" class="space-y-5">
          <div>
            <label for="login-id" class="block mb-1 text-sm font-medium text-gray-600">Mobile Number</label>
            <input type="text" id="login-id" name="mobile" placeholder="Enter mobile number" required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" />
          </div>

          <div>
            <label for="password" class="block mb-1 text-sm font-medium text-gray-600">Password</label>
            <input type="password" id="password" name="password" placeholder="Enter your password" required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" />
          </div>

          <div class="flex items-center justify-between">
            <label class="flex items-center">
              <input type="checkbox" name="remember-me" class="h-4 w-4 text-blue-600 border-gray-300 rounded">
              <span class="ml-2 text-sm text-gray-700">Remember me</span>
            </label>
            <a href="/forgetPassword" class="text-sm text-blue-600 hover:underline font-medium">Forgot password?</a>
          </div>

          <button type="submit" class="btn-primary">Login</button>
        </form>

        <p class="text-sm text-gray-500 mt-6 text-center">
          Don’t have an account?
          <a href="/signup_user" class="text-blue-600 hover:underline font-medium">Create one</a>
        </p>
      </div>

    </div>
  </section>
</body>
</html>