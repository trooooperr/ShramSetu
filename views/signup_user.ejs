<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ShramSetu | Sign Up</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="style/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    .btn-primary {
      background: linear-gradient(to right, #3b82f6, #2563eb);
      color: white;
      padding: 0.75rem 1.75rem;
      border-radius: 0.5rem;
      font-weight: 600;
      font-size: 1rem;
      border: none;
      cursor: pointer;
      width: 100%;
      transition: all 0.2s ease;
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
    }
    input:focus {
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
      outline: none;
    }
  </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-100 to-white">

<nav class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between py-4">
        <div class="hidden sm:flex items-center space-x-5">
          <a href="/" class="text-3xl font-bold text-blue-700 no-underline hover:no-underline">ShramSetu</a>
        </div>
        <div class="hidden sm:flex items-center space-x-5">
        <a href="#whyShramSetu" class="text-gray-700 hover:text-blue-600 hover:no-underline font-semibold">Why ShramSetu</a>
        <a href="/hire" class="text-gray-700 hover:text-blue-600 hover:no-underline font-semibold">Hire ShramSevik</a>
        <a href="/work" class="text-gray-700 hover:text-blue-600 hover:no-underline font-semibold">Find Work</a>
        <a href="#categories" class="text-gray-700 hover:text-blue-600 hover:no-underline font-semibold">Categories</a>
        <a href="/about" class="text-gray-700 hover:text-blue-600 hover:no-underline font-semibold">About Us</a>
        <a href="/login_user" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 font-semibold no-underline hover:no-underline">Join</a>
        </div>
        <div class="-mr-2 flex items-center sm:hidden">
          <button class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:bg-gray-100 focus:text-gray-500 transition">
            <svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <section class="flex justify-center items-center min-h-[calc(100vh-80px)] px-4 md:px-8 lg:px-24">
    <div class="flex flex-col lg:flex-row items-center justify-center gap-12 w-full max-w-6xl">

      <div class="w-full lg:w-2/5 px-4 lg:px-0 flex flex-col justify-center space-y-6">
        <div class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-100 to-blue-200 text-blue-800 text-sm font-semibold px-5 py-3 rounded-full shadow-md">
          <span class="animate-pulse">
            <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C11.45 2 11 2.45 11 3V5C11 5.55 11.45 6 12 6C12.55 6 13 5.55 13 5V3C13 2.45 12.55 2 12 2Z..."/>
            </svg>
          </span>
          <span class="tracking-wide">Empowering India's Workforce</span>
        </div>
        <h1 class="text-4xl lg:text-5xl font-extrabold text-gray-800 leading-snug">
          Start Your Journey<br class="hidden lg:block" />
          With <span class="text-blue-600">ShramSetu</span>
        </h1>
        <p class="text-gray-600 text-base lg:text-lg">
          Sign up today and connect with thousands of jobs and workers without any middlemen.
        </p>
        <div class="grid grid-cols-2 gap-4 mt-6 text-sm text-gray-800">
          <div class="flex items-center gap-3 bg-blue-50 px-4 py-3 rounded-lg">
            <div class="bg-blue-100 p-2 rounded-full">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <span class="font-medium">No middlemen</span>
          </div>
          <div class="flex items-center gap-3 bg-blue-50 px-4 py-3 rounded-lg">
            <div class="bg-blue-100 p-2 rounded-full">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <span class="font-medium">Direct matching</span>
          </div>
          <div class="flex items-center gap-3 bg-blue-50 px-4 py-3 rounded-lg">
            <div class="bg-blue-100 p-2 rounded-full">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <span class="font-medium">Realtime alerts</span>
          </div>
          <div class="flex items-center gap-3 bg-blue-50 px-4 py-3 rounded-lg">
            <div class="bg-blue-100 p-2 rounded-full">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <span class="font-medium">Secure identity</span>
          </div>
        </div>
      </div>

      <!-- Signup Form -->
      <div class="w-full lg:w-1/2 bg-white shadow-lg rounded-xl p-8 md:p-10 max-w-md mx-auto lg:mx-0">
        <h2 class="text-2xl font-bold text-gray-800 mb-3 text-center">Create Account</h2>
        <p class="text-gray-500 mb-6 text-sm text-center">Sign up to get started with ShramSetu</p>
        <form action="/signup_user" method="post" class="space-y-5">
          <div>
            <label for="name" class="block mb-1 text-sm font-medium text-gray-600">Name</label>
            <input type="text" id="name" name="name" placeholder="Enter your name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label for="signup-id" class="block mb-1 text-sm font-medium text-gray-600">Mobile Number</label>
            <input type="text" id="signup-id" name="mobile" placeholder="Enter your mobile number" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label for="signup-id" class="block mb-1 text-sm font-medium text-gray-600">Email</label>
            <input type="text" id="signup-id" name="email" placeholder="Enter your email id" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label for="signup-password" class="block mb-1 text-sm font-medium text-gray-600">Password</label>
            <input type="password" id="signup-password" name="password" placeholder="Create password" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label for="confirm-password" class="block mb-1 text-sm font-medium text-gray-600">Confirm Password</label>
            <input type="password" id="confirm-password" name="confirm_password" placeholder="Re-enter password" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <button type="submit" class="btn-primary">Sign Up</button>
        </form>
        <p class="text-sm text-gray-500 mt-6 text-center">
          Already have an account?
          <a href="/login_user" class="text-blue-600 hover:underline font-medium">Login</a>
        </p>
      </div>

    </div>
  </section>

  
</body>
</html>