<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Post a Job | ShramSetu</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
  <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <style>
    .image-preview { position: relative; display: inline-block; margin: 8px; }
    .remove-image {
      position: absolute; top: -8px; right: -8px;
      background-color: rgba(255, 0, 0, 0.8); color: white;
      border-radius: 50%; padding: 2px 6px; cursor: pointer; font-size: 12px;
    }
    .image-preview img { height: 100px; width: auto; border-radius: 8px; }
  </style>
</head>

<body class="bg-blue-50 text-gray-800">
  <!-- Navbar -->
  <nav class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between py-4">
        <div class="hidden sm:flex items-center space-x-5">
          <a href="/" class="text-3xl font-bold text-blue-700">ShramSetu</a>
        </div>
        <div class="hidden sm:flex items-center space-x-5">
          <a href="#whyShramSetu" class="hover:text-blue-600 font-semibold">Why ShramSetu</a>
          <a href="/hireworker" class="hover:text-blue-600 font-semibold">Hire ShramSevik</a>
          <a href="/signup_worker" class="hover:text-blue-600 font-semibold">Find Work</a>
          <a href="#categories" class="hover:text-blue-600 font-semibold">Categories</a>
          <a href="/about" class="hover:text-blue-600 font-semibold">About Us</a>
          <a href="/login_user" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 font-semibold">Join</a>
        </div>
      </div>
    </div>
  </nav>

  <main class="py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <form id="postJobForm" class="bg-white border border-blue-200 shadow-2xl rounded-2xl p-8 sm:p-10 space-y-10"
            method="post" action="/uploadproblem" enctype="multipart/form-data">

        <!-- Job Details Title -->
        <h2 class="text-2xl font-bold text-gray-800 text-center mb-6">
          <span class="text-blue-600 mr-3"><i class="fas fa-clipboard-list"></i></span>Tell Us About the Job
        </h2>

        <!-- Job Category Dropdown -->
        <section class="bg-white border border-blue-200 shadow-md rounded-xl p-6 space-y-6">
          <h2 class="text-2xl font-bold text-blue-700 flex items-center">
            <i class="fas fa-briefcase mr-3"></i> Job Details
          </h2>
          <div x-data="{ open: false, selected: 'Select a category', options: ['Plumbing', 'Electrical', 'Carpentry', 'Painting', 'Gardening', 'House Cleaning'] }" class="relative">
            <label class="block text-sm font-medium mb-1">Job Category</label>
            <button @click="open = !open" type="button" class="w-full bg-blue-100 text-blue-900 px-4 py-3 rounded-md flex justify-between">
              <span x-text="selected" class="text-left w-full"></span>
              <i class="fas fa-caret-down text-blue-600 text-lg"></i>
            </button>
            <ul x-show="open" @click.outside="open = false" class="absolute z-20 mt-1 w-full bg-white border border-blue-300 rounded-md shadow max-h-60 overflow-y-auto">
              <template x-for="option in options" :key="option">
                <li @click="selected = option; open = false"
                    class="px-4 py-2 hover:bg-blue-100 cursor-pointer text-blue-900 flex items-center">
                  <i class="fas fa-check-circle text-blue-400 mr-2"></i>
                  <span x-text="option"></span>
                </li>
              </template>
            </ul>
            <input type="hidden" name="job" :value="selected === 'Select a category' ? '' : selected">
          </div>

          <!-- Job Description -->
          <div>
            <label for="jobDescription" class="block text-sm font-medium mb-1">Job Description</label>
            <textarea name="description" id="jobDescription" rows="4" required
                      placeholder="Describe the work to be done"
                      class="w-full border px-4 py-2 rounded-md focus:ring-2 focus:ring-blue-500"></textarea>
          </div>

          <!-- Image Upload -->
          <div>
            <label class="block text-sm font-medium mb-1">Upload Images</label>
            <input type="file" id="jobImages" name="pictures[]" accept="image/*" multiple class="w-full border px-3 py-2 rounded-md">
            <p class="text-sm text-gray-500 mt-1">Max 4 images, total 10MB</p>
            <div id="previewImages" class="mt-4 flex flex-wrap gap-2"></div>
          </div>

          <!-- Budget -->
          <div>
            <label for="jobBudget" class="block text-sm font-medium mb-1">Estimated Budget (₹)</label>
            <input type="number" name="estimate_budget" id="jobBudget" placeholder="500" min="100"
                   class="w-full border px-4 py-2 rounded-md focus:ring-2 focus:ring-blue-500">
          </div>
        </section>

        <!-- Location Section -->
        <section class="bg-white border border-blue-200 shadow-md rounded-xl p-6 space-y-6">
          <h2 class="text-xl font-semibold text-blue-700 flex items-center gap-2">
            <i class="fas fa-map-marker-alt text-blue-600"></i> Location Details
          </h2>
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <button id="detectLocationBtn" type="button"
                    class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm">
              <i class="fas fa-location-arrow"></i> Detect My Location
            </button>
            <span id="locationStatus" class="text-gray-600 text-sm italic"></span>
          </div>
          <div>
            <label for="jobAddress" class="block font-medium mb-1">Full Address</label>
            <textarea id="jobAddress" name="formattedAddress" rows="3" required
                      class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-blue-500"
                      placeholder="Enter your full address"></textarea>
            <input type="hidden" name="latitude" id="latitudeField">
            <input type="hidden" name="longitude" id="longitudeField">
          </div>
        </section>

        <!-- Contact Section -->
        <section class="bg-white border border-blue-200 shadow-md rounded-xl p-6 space-y-6">
          <h2 class="text-2xl font-bold text-blue-700 flex items-center">
            <i class="fas fa-id-card-alt mr-3"></i> Contact Information
          </h2>
          <div>
            <label for="contactName" class="block text-sm font-medium mb-1">Your Name</label>
            <input type="text" id="contactName" name="name" required placeholder="Your Name"
                   class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label for="contactPhone" class="block text-sm font-medium mb-1">Phone Number</label>
            <input type="tel" id="contactPhone" name="mobile" required placeholder="+91-9999999999"
                   class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-blue-500">
          </div>
        </section>

        <!-- Submit -->
        <div class="text-center pt-6">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-md shadow">
            Post Job
          </button>
        </div>
      </form>
    </div>
  </main>

  <!-- JS Script -->
  <script>
    const imageInput = document.getElementById('jobImages');
    const previewImages = document.getElementById('previewImages');
    let imageFiles = [];

    imageInput.addEventListener('change', (event) => {
      const files = Array.from(event.target.files);
      if ((imageFiles.length + files.length) > 4) {
        alert('You can upload a maximum of 4 images.');
        return;
      }
      files.forEach(file => {
        if ((file.size / (1024 * 1024)) > 10) {
          alert(`Image ${file.name} exceeds 10MB.`);
          return;
        }
        const reader = new FileReader();
        reader.onload = (e) => {
          const div = document.createElement('div');
          div.classList.add('image-preview');
          const img = document.createElement('img');
          img.src = e.target.result;
          const removeBtn = document.createElement('span');
          removeBtn.classList.add('remove-image');
          removeBtn.innerHTML = '&times;';
          removeBtn.addEventListener('click', () => {
            previewImages.removeChild(div);
            imageFiles = imageFiles.filter(f => f !== file);
          });
          div.appendChild(img);
          div.appendChild(removeBtn);
          previewImages.appendChild(div);
        };
        reader.readAsDataURL(file);
        imageFiles.push(file);
      });
    });

    document.getElementById('detectLocationBtn').addEventListener('click', () => {
      const addressField = document.getElementById('jobAddress');
      const locationStatus = document.getElementById('locationStatus');
      const latField = document.getElementById('latitudeField');
      const longField = document.getElementById('longitudeField');

      locationStatus.textContent = 'Detecting your location...';
      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(async (position) => {
          const { latitude, longitude } = position.coords;
          latField.value = latitude;
          longField.value = longitude;
          try {
            const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}`);
            const data = await response.json();
            addressField.value = data.display_name;
            locationStatus.textContent = 'Location detected successfully!';
          } catch {
            locationStatus.textContent = 'Unable to retrieve address.';
          }
        }, () => {
          locationStatus.textContent = 'Permission denied or unavailable.';
        });
      } else {
        locationStatus.textContent = 'Geolocation not supported.';
      }
    });
  </script>
</body>
</html>
