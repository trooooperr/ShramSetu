        </div>
    </section>

    <section class="our-values-section">
      <div class="our-values-container">
        <h2>Our Core Values</h2>
        <div class="values-grid">
          <div class="value">
            <i class="fas fa-users fa-2x" style="color: #1976d2;"></i>
            <h3>Empowerment</h3>
            <p>We empower individuals by providing access to opportunities and resources for career growth.</p>
          </div>
          <div class="value">
            <i class="fas fa-connectdevelop fa-2x" style="color: #1976d2;"></i>
            <h3>Connectivity</h3>
            <p>We foster meaningful connections between job seekers and employers, creating a vibrant ecosystem.</p>
          </div>
          <div class="value">
            <i class="fas fa-handshake fa-2x" style="color: #1976d2;"></i>
            <h3>Trust & Reliability</h3>
            <p>We are committed to building a trustworthy and reliable platform through transparency and integrity.</p>
          </div>
          <div class="value">
            <i class="fas fa-lightbulb fa-2x" style="color: #1976d2;"></i>
            <h3>Innovation</h3>
            <p>We continuously strive for innovative solutions and technologies to improve the ShramSetu experience.</p>
          </div>
          </div>
      </div>
    </section>
