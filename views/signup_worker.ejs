<script>
document.addEventListener('DOMContentLoaded', function() {
    // --- Skill/Category Selection Logic ---
    const skillsInput = document.getElementById('skillsInput');
    const addSkillBtn = document.getElementById('addSkillBtn');
    const selectedSkillsHiddenInput = document.getElementById('selectedSkills'); // This input can store the final comma-separated skills
    const suggestedSkillsContainer = document.getElementById('suggestedSkills');
    const selectedSkillsDisplay = document.getElementById('selectedSkillsDisplay');
    const workerProfileForm = document.getElementById('workerProfileForm'); // Make sure this ID exists in HTML!

    let selectedSkills = []; // Stores skills as an array

    function renderSkills() {
        selectedSkillsDisplay.innerHTML = '';
        selectedSkills.forEach(skill => {
            const tag = document.createElement('span');
            tag.classList.add('skill-tag');
            tag.innerHTML = `${skill} <span class="remove-tag" data-skill="${skill}">&times;</span>`;
            selectedSkillsDisplay.appendChild(tag);
        });
        // Update the hidden input to send to the server if needed (though FormData is used below)
        selectedSkillsHiddenInput.value = selectedSkills.join(',');
    }

    function addSkillFromInput() {
        const newSkill = skillsInput.value.trim();
        if (newSkill !== '' && !selectedSkills.includes(newSkill)) {
            selectedSkills.push(newSkill);
            renderSkills();
            skillsInput.value = '';
        }
    }

    skillsInput.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
            event.preventDefault(); // Prevent form submission if input is in a form
            addSkillFromInput();
        }
    });

    addSkillBtn.addEventListener('click', addSkillFromInput);

    selectedSkillsDisplay.addEventListener('click', function(event) {
        if (event.target.classList.contains('remove-tag')) {
            const skillToRemove = event.target.dataset.skill;
            selectedSkills = selectedSkills.filter(skill => skill !== skillToRemove);
            renderSkills();
        }
    });

    suggestedSkillsContainer.addEventListener('click', function(event) {
        if (event.target.classList.contains('suggested-skill-button')) {
            const skillToAdd = event.target.dataset.skill;
            if (!selectedSkills.includes(skillToAdd)) {
                selectedSkills.push(skillToAdd);
                renderSkills();
            }
        }
    });

    renderSkills(); // Initial render if there are pre-selected skills (e.g., for editing)

    // --- Selectable Blocks ---
    function setupSelectableBlocks(selector, inputType = 'checkbox') {
        const labels = document.querySelectorAll(selector);
        labels.forEach(label => {
            const input = label.querySelector(`input[type="${inputType}"]`);
            if (!input) return;

            const updateVisualState = () => {
                if (input.checked) {
                    label.classList.add('selected');
                } else {
                    label.classList.remove('selected');
                }
            };

            updateVisualState();
            label.addEventListener('click', function(event) {
                event.preventDefault();
                if (inputType === 'checkbox') {
                    input.checked = !input.checked;
                } else if (inputType === 'radio') {
                    // This handles only one radio button per group
                    input.checked = true;
                    document.querySelectorAll(`input[name="${input.name}"]`).forEach(otherInput => {
                        if (otherInput !== input) {
                            otherInput.closest('.selectable-block').classList.remove('selected');
                        }
                    });
                }
                updateVisualState();
                input.dispatchEvent(new Event('change'));
            });

            input.addEventListener('change', updateVisualState);
        });
    }

    setupSelectableBlocks('.day-label', 'checkbox');
    setupSelectableBlocks('.time-slot-label', 'checkbox');
    setupSelectableBlocks('.availability-type-label', 'checkbox');
    setupSelectableBlocks('.communication-channel-label', 'checkbox');
    setupSelectableBlocks('.payment-method-label', 'radio');

    // --- Select All Days Logic ---
    const selectAllDaysCheckbox = document.getElementById('selectAllDays');
    const dayCheckboxes = document.querySelectorAll('.day-checkbox:not(#selectAllDays)');

    if (selectAllDaysCheckbox) { // Check if element exists
        selectAllDaysCheckbox.addEventListener('change', function() {
            dayCheckboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
                checkbox.closest('.selectable-block').classList.toggle('selected', this.checked);
            });
        });
    }

    dayCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            const allChecked = Array.from(dayCheckboxes).every(cb => cb.checked);
            if (selectAllDaysCheckbox) {
                selectAllDaysCheckbox.checked = allChecked;
                selectAllDaysCheckbox.closest('.selectable-block').classList.toggle('selected', allChecked);
            }
            this.closest('.selectable-block').classList.toggle('selected', this.checked);
        });
    });

    // --- Flexible Time Slot Logic ---
    const flexibleTimeSlotCheckbox = document.getElementById('flexibleTimeSlot');
    const morningTimeSlot = document.getElementById('morningTimeSlot');
    const afternoonTimeSlot = document.getElementById('afternoonTimeSlot');
    const eveningTimeSlot = document.getElementById('eveningTimeSlot');
    const individualTimeSlotCheckboxes = [morningTimeSlot, afternoonTimeSlot, eveningTimeSlot];

    if (flexibleTimeSlotCheckbox) {
        flexibleTimeSlotCheckbox.addEventListener('change', function() {
            individualTimeSlotCheckboxes.forEach(cb => {
                if (cb) { // Ensure checkbox exists
                    cb.checked = this.checked;
                    cb.closest('.selectable-block').classList.toggle('selected', this.checked);
                }
            });
            this.closest('.selectable-block').classList.toggle('selected', this.checked);
        });
    }

    individualTimeSlotCheckboxes.forEach(cb => {
        if (cb) { // Ensure checkbox exists
            cb.addEventListener('change', function() {
                this.closest('.selectable-block').classList.toggle('selected', this.checked);
                const allChecked = individualTimeSlotCheckboxes.every(c => c && c.checked);
                if (flexibleTimeSlotCheckbox) {
                    flexibleTimeSlotCheckbox.checked = allChecked;
                    flexibleTimeSlotCheckbox.closest('.selectable-block').classList.toggle('selected', allChecked);
                }
            });
        }
    });

    // --- Work Type Logic ---
    const bothWorkTypeCheckbox = document.getElementById('bothWorkType');
    const fullTimeOptionCheckbox = document.getElementById('fullTimeOption');
    const partTimeOptionCheckbox = document.getElementById('partTimeOption');
    const individualWorkTypeCheckboxes = [fullTimeOptionCheckbox, partTimeOptionCheckbox];

    if (bothWorkTypeCheckbox) {
        bothWorkTypeCheckbox.addEventListener('change', function() {
            individualWorkTypeCheckboxes.forEach(cb => {
                if (cb) {
                    cb.checked = this.checked;
                    cb.closest('.selectable-block').classList.toggle('selected', this.checked);
                }
            });
            this.closest('.selectable-block').classList.toggle('selected', this.checked);
        });
    }

    individualWorkTypeCheckboxes.forEach(cb => {
        if (cb) {
            cb.addEventListener('change', function() {
                this.closest('.selectable-block').classList.toggle('selected', this.checked);
                const allChecked = individualWorkTypeCheckboxes.every(c => c && c.checked);
                if (bothWorkTypeCheckbox) {
                    bothWorkTypeCheckbox.checked = allChecked;
                    bothWorkTypeCheckbox.closest('.selectable-block').classList.toggle('selected', allChecked);
                }
            });
        }
    });

    // --- Payment Method Visibility and Required Attributes ---
    const paymentMethodRadios = document.querySelectorAll('input[name="paymentMethod"]');
    const bankDetailsDiv = document.getElementById('bankDetails');
    const upiDetailsDiv = document.getElementById('upiDetails');

    // Get references to the specific input fields
    const bankAccountNoInput = document.getElementById('bankAccountNo');
    const ifscInput = document.getElementById('ifsc');
    const upiIdInput = document.getElementById('upiId');

    function updatePaymentDetailsVisibility() {
        // Hide both and remove required attributes first
        bankDetailsDiv.classList.add('hidden');
        upiDetailsDiv.classList.add('hidden');
        if (bankAccountNoInput) bankAccountNoInput.removeAttribute('required');
        if (ifscInput) ifscInput.removeAttribute('required');
        if (upiIdInput) upiIdInput.removeAttribute('required');

        const selected = Array.from(paymentMethodRadios).find(r => r.checked)?.value;
        if (selected === 'upi') {
            upiDetailsDiv.classList.remove('hidden');
            if (upiIdInput) upiIdInput.setAttribute('required', 'true');
        }
        if (selected === 'bank-transfer') {
            bankDetailsDiv.classList.remove('hidden');
            if (bankAccountNoInput) bankAccountNoInput.setAttribute('required', 'true');
            if (ifscInput) ifscInput.setAttribute('required', 'true');
        }
    }

    paymentMethodRadios.forEach(r => r.addEventListener('change', updatePaymentDetailsVisibility));
    updatePaymentDetailsVisibility(); // Call on initial load

    // --- Radius Sync ---
    const serviceRadiusInput = document.getElementById('serviceRadius');
    const serviceRadiusRange = document.getElementById('serviceRadiusRange');

    if (serviceRadiusInput && serviceRadiusRange) { // Check if elements exist
        serviceRadiusInput.addEventListener('input', function() {
            serviceRadiusRange.value = this.value;
        });

        serviceRadiusRange.addEventListener('input', function() {
            serviceRadiusInput.value = this.value;
        });
    }


    // --- Form Submit via JS (Send to /signup_worker) ---
    // Ensure workerProfileForm is not null before adding event listener
    if (workerProfileForm) {
        workerProfileForm.addEventListener('submit', async function(event) {
            event.preventDefault(); // Stop the default form submission

            const formData = new FormData(workerProfileForm);

            // Add selected skills to formData under a specific key (e.g., 'workerSkills')
            formData.set('workerSkills', selectedSkills.join(','));

            // Check if passwords match (client-side)
            const password = formData.get('password');
            const confirm_password = formData.get('confirm_password');

            if (password !== confirm_password) {
                alert('Passwords do not match!');
                return; // Stop submission
            }
            // You might want to remove confirm_password from formData before sending to backend
            formData.delete('confirm_password');

            try {
                // Remove the extra console.log here, only one is needed now
                const response = await fetch('/signup_worker', {
                    method: 'POST',
                    body: formData
                });

                // Always parse the response as JSON as per our backend changes
                const result = await response.json();

                if (response.ok && result.success) { // Check HTTP status and custom success flag
                    console.log("✅ Server response:", result.message);

                    const messageBox = document.createElement('div');
                    messageBox.style.cssText = `
                        position: fixed;
                        top: 50%;
                        left: 50%;
                        transform: translate(-50%, -50%);
                        background-color: #4CAF50;
                        color: white;
                        padding: 15px 25px;
                        border-radius: 8px;
                        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
                        z-index: 1000;
                        font-size: 1.1rem;
                        display: flex;
                        align-items: center;
                        gap: 10px;
                    `;
                    messageBox.innerHTML = `<i class="fas fa-check-circle"></i> ${result.message}`;
                    document.body.appendChild(messageBox);

                    setTimeout(() => {
                        messageBox.remove();
                        if (result.redirectUrl) {
                            window.location.href = result.redirectUrl; // Redirect to the URL provided by the server
                        } else {
                            window.location.href = '/profile'; // Fallback redirect
                        }
                    }, 3000);
                } else {
                    // Server responded with an error or success: false
                    console.error("❌ Server error:", result.message || "Unknown error occurred.");
                    alert(result.message || "Form submission failed. Please try again.");
                }
            } catch (err) {
                // Network error or parsing error
                alert("Form submission failed. Check console for details.");
                console.error("❌ Network or client-side Error:", err);
            }
        });
    } else {
        console.error("Error: Element with ID 'workerProfileForm' not found. Submit listener not attached.");
    }
});
</script>


