  <!-- Hero Section -->
  <section class="bg-primary text-white text-center py-12">
    <div class="max-w-3xl mx-auto px-4" data-aos="fade" data-aos-duration="1000" data-aos-easing="ease-in-out">
      <h1 class="text-4xl font-extrabold mb-3">How to Hire Workers</h1>
      <p class="text-lg font-medium leading-relaxed">
        A simple step-by-step guide to help you find the right workers for your job.
      </p>
    </div>
  </section>

  <!-- Steps Section -->
  <main class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

      <!-- Repeat this block for each step -->
      <div class="bg-white shadow-card rounded-xl p-5 h-[180px] flex flex-col justify-between" data-aos="fade-up">
        <div class="flex items-center space-x-4">
          <div class="icon-circle"><i class="fa fa-user-plus"></i></div>
          <h2 class="text-lg font-bold text-primary">1. Create Account</h2>
        </div>
        <ul class="text-[15px] text-gray-700 mt-2 space-y-1 ml-1">
          <li>Sign up or log in to ShramSetu.</li>
          <li>Manage hiring and connect with workers.</li>
        </ul>
        <p class="text-sm italic text-primary font-semibold text-right">Start your hiring journey.</p>
      </div>

      <div class="bg-white shadow-card rounded-xl p-5 h-[180px] flex flex-col justify-between" data-aos="fade-up">
        <div class="flex items-center space-x-4">
          <div class="icon-circle"><i class="fa fa-briefcase"></i></div>
          <h2 class="text-lg font-bold text-primary">2. Post a Job</h2>
        </div>
        <ul class="text-[15px] text-gray-700 mt-2 space-y-1 ml-1">
          <li>Fill category, budget & job location.</li>
          <li>Add details & optional images.</li>
        </ul>
        <p class="text-sm italic text-primary font-semibold text-right">Clear posts get faster responses.</p>
      </div>

      <div class="bg-white shadow-card rounded-xl p-5 h-[180px] flex flex-col justify-between" data-aos="fade-up">
        <div class="flex items-center space-x-4">
          <div class="icon-circle"><i class="fa fa-search"></i></div>
          <h2 class="text-lg font-bold text-primary">3. Browse Workers</h2>
        </div>
        <ul class="text-[15px] text-gray-700 mt-2 space-y-1 ml-1">
          <li>Filter by skills & location.</li>
          <li>Check experience and reviews.</li>
        </ul>
        <p class="text-sm italic text-primary font-semibold text-right">Find the perfect match.</p>
      </div>

      <div class="bg-white shadow-card rounded-xl p-5 h-[180px] flex flex-col justify-between" data-aos="fade-up" data-aos-delay="200">
        <div class="flex items-center space-x-4">
          <div class="icon-circle"><i class="fa fa-comments"></i></div>
          <h2 class="text-lg font-bold text-primary">4. Contact Workers</h2>
        </div>
        <ul class="text-[15px] text-gray-700 mt-2 space-y-1 ml-1">
          <li>Message or call to confirm job.</li>
          <li>Clarify scope and expectations.</li>
        </ul>
        <p class="text-sm italic text-primary font-semibold text-right">Good talk leads to good work.</p>
      </div>

      <div class="bg-white shadow-card rounded-xl p-5 h-[180px] flex flex-col justify-between" data-aos="fade-up" data-aos-delay="200">
        <div class="flex items-center space-x-4">
          <div class="icon-circle"><i class="fa fa-handshake"></i></div>
          <h2 class="text-lg font-bold text-primary">5. Confirm & Start</h2>
        </div>
        <ul class="text-[15px] text-gray-700 mt-2 space-y-1 ml-1">
          <li>Agree on payment & deadlines.</li>
          <li>Start job with clear expectations.</li>
        </ul>
        <p class="text-sm italic text-primary font-semibold text-right">Clarity avoids confusion.</p>
      </div>

      <div class="bg-white shadow-card rounded-xl p-5 h-[180px] flex flex-col justify-between" data-aos="fade-up" data-aos-delay="200">
        <div class="flex items-center space-x-4">
          <div class="icon-circle"><i class="fa fa-star"></i></div>
          <h2 class="text-lg font-bold text-primary">6. Rate & Review</h2>
        </div>
        <ul class="text-[15px] text-gray-700 mt-2 space-y-1 ml-1">
          <li>Leave honest feedback.</li>
          <li>Help workers grow their reputation.</li>
        </ul>
        <p class="text-sm italic text-primary font-semibold text-right">Your review helps the community.</p>
      </div>

    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-800 text-gray-300 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
