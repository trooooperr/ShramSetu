<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ShramSetu | Worker Guide</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            inter: ['Inter', 'sans-serif']
          },
          colors: {
            primary: '#1976D2',
            primaryDark: '#1565C0',
            bgLight: '#F0F4FA'
          },
          boxShadow: {
            card: '0 4px 14px rgba(21, 101, 192, 0.15)'
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }

    .icon-circle {
      width: 48px;
      height: 48px;
      background-color: #1565C0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      color: white;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
      transition: transform 0.3s ease;
    }

    .icon-circle:hover {
      transform: scale(1.1);
    }
  </style>
</head>

<body class="bg-bgLight text-gray-800">

  <!-- Navbar -->
  <nav class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between py-4">
        <div class="hidden sm:flex items-center space-x-5">
          <a href="/" class="text-3xl font-bold text-blue-700">ShramSetu</a>
        </div>
        <div class="hidden sm:flex items-center space-x-5">
          <a href="#whyShramSetu" class="text-gray-700 font-semibold hover:text-blue-600">Why ShramSetu</a>
          <a href="/hire" class="text-gray-700 font-semibold hover:text-blue-600">Hire ShramSevik</a>
          <a href="/work" class="text-gray-700 font-semibold hover:text-blue-600">Find Work</a>
          <a href="#categories" class="text-gray-700 font-semibold hover:text-blue-600">Categories</a>
          <a href="/about" class="text-gray-700 font-semibold hover:text-blue-600">About Us</a>
          <a href="/login_user" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 font-semibold">Join</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
<section class="bg-primary text-white text-center py-12">
  <div class="max-w-3xl mx-auto px-4" 
       data-aos="fade" 
       data-aos-duration="1000" 
       data-aos-easing="ease-in-out">
    <h1 class="text-4xl font-extrabold mb-3">Get Started as a Worker</h1>
    <p class="text-lg font-medium leading-relaxed">
      A quick, clear guide to help you find and complete jobs effectively on ShramSetu.
    </p>
  </div>
</section>

  <!-- Step Cards -->
  <main class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

      <!-- Repeat for each step -->
      <!-- First Row -->
      <div class="bg-white shadow-card rounded-xl p-5 h-[180px] flex flex-col justify-between" data-aos="fade-up" data-aos-delay="100">
        <div class="flex items-center space-x-4">
          <div class="icon-circle"><i class="fa fa-user-plus"></i></div>
          <h2 class="text-lg font-bold text-primary">1. Create Your Profile</h2>
        </div>
        <ul class="text-[15px] text-gray-700 mt-2 space-y-1 ml-1">
          <li>Add skills, location, and a recent photo.</li>
          <li>Set accurate availability and contact info.</li>
        </ul>
        <p class="text-sm italic text-primary font-semibold text-right">Your profile is your resume.</p>
      </div>

      <div class="bg-white shadow-card rounded-xl p-5 h-[180px] flex flex-col justify-between" data-aos="fade-up" data-aos-delay="100">
        <div class="flex items-center space-x-4">
          <div class="icon-circle"><i class="fa fa-search"></i></div>
          <h2 class="text-lg font-bold text-primary">2. Browse Jobs</h2>
        </div>
        <ul class="text-[15px] text-gray-700 mt-2 space-y-1 ml-1">
          <li>Filter by skills, wage, and location.</li>
          <li>Apply to fresh listings every day.</li>
        </ul>
        <p class="text-sm italic text-primary font-semibold text-right">Opportunities are daily!</p>
      </div>

      <div class="bg-white shadow-card rounded-xl p-5 h-[180px] flex flex-col justify-between" data-aos="fade-up" data-aos-delay="100">
        <div class="flex items-center space-x-4">
          <div class="icon-circle"><i class="fa fa-handshake"></i></div>
          <h2 class="text-lg font-bold text-primary">3. Apply</h2>
        </div>
        <ul class="text-[15px] text-gray-700 mt-2 space-y-1 ml-1">
          <li>Understand the work requirement fully.</li>
          <li>Match your experience to job clearly.</li>
        </ul>
        <p class="text-sm italic text-primary font-semibold text-right">Be quick and confident.</p>
      </div>

      <!-- Second Row -->
      <div class="bg-white shadow-card rounded-xl p-5 h-[180px] flex flex-col justify-between" data-aos="fade-up" data-aos-delay="300">
        <div class="flex items-center space-x-4">
          <div class="icon-circle"><i class="fa fa-comments"></i></div>
          <h2 class="text-lg font-bold text-primary">4. Communicate</h2>
        </div>
        <ul class="text-[15px] text-gray-700 mt-2 space-y-1 ml-1">
          <li>Ask questions before job starts.</li>
          <li>Speak respectfully always.</li>
        </ul>
        <p class="text-sm italic text-primary font-semibold text-right">Talk builds trust.</p>
      </div>

      <div class="bg-white shadow-card rounded-xl p-5 h-[180px] flex flex-col justify-between" data-aos="fade-up" data-aos-delay="300">
        <div class="flex items-center space-x-4">
          <div class="icon-circle"><i class="fa fa-check-circle"></i></div>
          <h2 class="text-lg font-bold text-primary">5. Complete Work</h2>
        </div>
        <ul class="text-[15px] text-gray-700 mt-2 space-y-1 ml-1">
          <li>Finish job on time with quality.</li>
          <li>Be honest and consistent.</li>
        </ul>
        <p class="text-sm italic text-primary font-semibold text-right">Punctuality matters.</p>
      </div>

      <div class="bg-white shadow-card rounded-xl p-5 h-[180px] flex flex-col justify-between" data-aos="fade-up" data-aos-delay="300">
        <div class="flex items-center space-x-4">
          <div class="icon-circle"><i class="fa fa-star"></i></div>
          <h2 class="text-lg font-bold text-primary">6. Earn Reviews</h2>
        </div>
        <ul class="text-[15px] text-gray-700 mt-2 space-y-1 ml-1">
          <li>Ask employers to leave reviews.</li>
          <li>Good work brings more offers.</li>
        </ul>
        <p class="text-sm italic text-primary font-semibold text-right">Stars grow reputation.</p>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-800 text-gray-300 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid gap-8 items-start"
      style="grid-template-columns: 2fr 1fr 1fr 1fr;"
    >
      <!-- Column 1: ShramSetu Info (Vertically Centered) -->
      <div class="flex flex-col items-center text-center h-full justify-center">
        <div>
          <h4 class="text-lg font-semibold text-white mb-2">ShramSetu</h4>
          <p class="text-sm">Connecting skilled laborers with opportunities.</p>
        </div>
        <div class="mt-6">
          <p class="text-sm">&copy; 2025 ShramSetu. All rights reserved.</p>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="flex flex-col justify-start">
        <h4 class="text-lg font-semibold text-white mb-4">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="#whyShramSetu" class="hover:text-gray-100">Why ShramSetu</a></li>
          <li><a href="#howItWork" class="hover:text-gray-100">How It Works</a></li>
          <li><a href="#categories" class="hover:text-gray-100">Categories</a></li>
          <li><a href="/benefits" class="hover:text-gray-100">Benefits</a></li>
          <li><a href="/about" class="hover:text-gray-100">About Us</a></li>
          <li><a href="#contact" class="hover:text-gray-100">Contact Us</a></li>
        </ul>
      </div>

      <!-- Column 3: Legal -->
      <div class="flex flex-col justify-start">
        <h4 class="text-lg font-semibold text-white mb-4">Legal</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/privacy" class="hover:text-gray-100">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-gray-100">Terms of Service</a></li>
          <li><a href="/disclaimer" class="hover:text-gray-100">Disclaimer</a></li>
        </ul>
      </div>

      <!-- Column 4: Follow Us -->
      <div class="flex flex-col justify-start">
        <h4 class="text-lg font-semibold text-white mb-4">Follow Us</h4>
        <div class="flex space-x-4">
          <a href="#" class="text-gray-300 hover:text-white"><i class="fab fa-facebook fa-lg"></i></a>
          <a href="#" class="text-gray-300 hover:text-white"><i class="fab fa-twitter fa-lg"></i></a>
          <a href="#" class="text-gray-300 hover:text-white"><i class="fab fa-linkedin fa-lg"></i></a>
          <a href="#" class="text-gray-300 hover:text-white"><i class="fab fa-instagram fa-lg"></i></a>
        </div>
      </div>
    </div>

    <!-- Bottom Note -->
    <div class="mt-10 text-center text-sm text-gray-400">
      <p>ShramSetu - Empowering Connections Across India</p>
    </div>
  </div>
</footer>

  <!-- Scripts -->
  <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
  <script>
    AOS.init({
      duration: 900,
      once: true,
      delay: 100,
    });
  </script>
</body>

</html> 