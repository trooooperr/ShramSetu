<!-- forgot-password.html -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Forgot Password | ShramSetu</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background: #f5f9ff; }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center px-4">
  <div class="max-w-md w-full bg-white shadow-lg rounded-xl p-8 space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-center text-gray-800">Forgot Password</h2>
      <p class="text-sm text-center text-gray-500">Enter your registered email and we'll send a reset link.</p>
    </div>
    <form class="space-y-4" method="post" action="/forgetPassword">
      <div>
        <label class="block text-sm font-medium text-gray-700">Email Address</label>
        <input type="email" name="email" required placeholder="Enter your email" class="mt-1 block w-full rounded-md border border-gray-300 px-4 py-2 shadow-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>
      <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded-md transition">Send Reset Link</button>
    </form>
    <p class="text-center text-sm text-gray-500">Back to <a href="/login_user" class="text-blue-600 hover:underline">Login</a></p>
  </div>
</body>
</html>